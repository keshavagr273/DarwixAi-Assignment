# PARLEY Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# Never commit .env to version control.

# ─── Server ────────────────────────────────────────────────────────────────
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Frontend (Vite reads from project root via envDir: '../') ─────────────
VITE_API_MODE=mock
VITE_API_BASE_URL=http://127.0.0.1:8000

# ─── PostgreSQL (Source of Truth — pgvector required) ─────────────────────
# Local: postgresql://parley_user:parley_dev@localhost:5432/parley_db
# Cloud: Get from Aiven / Supabase / Neon dashboard
DATABASE_URL=postgresql://parley_user:parley_dev@localhost:5432/parley_db

# ─── Redis (Session cache, nudge cooldowns, rate limiting) ────────────────
# Local: redis://localhost:6379/0
# Upstash TLS: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage (Cloudflare R2 / MinIO / AWS S3) ─────────────────────
# Local MinIO: endpoint=localhost:9000, key=minioadmin, secret=minioadmin
# Cloudflare R2: get keys from R2 > Manage R2 API Tokens
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=darwix-assignment

# ─── LLM (Groq) ────────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─── ASR (Deepgram streaming speech-to-text) ──────────────────────────────
# Get from: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ─── TTS (ElevenLabs native voices) ───────────────────────────────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ─── Embeddings (Cohere embed-multilingual-v3.0 — 1024-dim semantic search) ───
# Get from: https://dashboard.cohere.com/api-keys
EMBEDDING_BASE_URL=https://api.cohere.com/v1
EMBEDDING_API_KEY=your_cohere_api_key_here
EMBEDDING_MODEL=embed-multilingual-v3.0
