# PARLEY Environment Configuration Example
# Copy this file to .env and supply actual keys if running in live mode.

# Environment Mode: mock | live
PARLEY_ENV=mock
VITE_API_MODE=mock
PORT=8000
HOST=127.0.0.1

# Database Configuration (Postgres 16 + pgvector)
DATABASE_URL=postgresql://parley_user:parley_secret_dev@localhost:5432/parley_db
RETRIEVER_DATABASE_URL=postgresql://retriever_user:retriever_dev@localhost:5432/parley_db
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO or S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=parley-audio-store

# LLM Providers (Claude Anthropic / OpenAI / Groq)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022
GROQ_API_KEY=your_groq_api_key_here

# Speech & Voice (ASR & TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Embeddings & Reranking
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Security & Secret Scanning
ENCRYPTION_KEY_PII_VAULT=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=dev_jwt_secret_must_be_changed_in_prod

# Webhook Integrations
HUMAN_ESCALATION_WEBHOOK_URL=http://localhost:8000/api/v1/agent/escalations/webhook
CRM_WEBHOOK_URL=http://localhost:8000/api/v1/agent/crm/lead
