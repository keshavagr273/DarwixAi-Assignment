# Environment and Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12

# Runtime / append-only log files (written at runtime — not source-of-truth)
# Keep .gitkeep sentinels so directories exist on fresh clone
data/crm/*.jsonl
data/evaluation/gate_log.jsonl
data/evaluation/nudge_log.jsonl

# Large binary media / audio recordings
data/audio/*.wav
data/audio/*.mp3
data/audio/*.webm
data/audio/*.ogg
data/audio/*.flac

# Local database files
*.db
*.sqlite
*.sqlite3

