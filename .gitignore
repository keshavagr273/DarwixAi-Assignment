# Dependencies
node_modules/
**/node_modules/

# Production build artifacts
dist/
**/dist/
dist-ssr/
build/

# Vite & dev server cache
.vite/
**/.vite/

# Python cache & environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
*.egg-info/
.installed.cfg
*.egg
